# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 으로 노출하지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 선택: 카카오 로컬 API REST 키 (developers.kakao.com > 내 애플리케이션 > 앱 키)
# 비워 두면 오픈스트리트맵 식당 데이터를 쓴다 (식당 수가 적음)
KAKAO_REST_API_KEY=

# Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=
# 선택: 기본값 gemini-flash-latest
GEMINI_MODEL=
